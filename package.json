{
  "name": "archcanvas",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted house planning for Pakistani plots: 2D plan, 3D view, plan check and grey structure estimate.",
  "workspaces": [
    "engine",
    "web",
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @archcanvas/web",
    "dev:api": "npm run dev -w @archcanvas/api",
    "dev:engine": "npm run dev -w blueprint3d-babylon",
    "build": "npm run build -w @archcanvas/web",
    "test": "npm test -w @archcanvas/api && npm test -w blueprint3d-babylon"
  }
}
