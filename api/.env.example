# Copy to api/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string, or a local server
MONGODB_URI=mongodb://127.0.0.1:27017/archcanvas

# The web app's address, allowed by CORS and used for cookies
CLIENT_ORIGIN=http://localhost:5173

# Auth. Use long random strings (32+ characters), e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production with the placeholders below.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Ask ArchCanvas (AI). Free Gemini key from https://aistudio.google.com/apikey
# Any OpenAI-compatible API works by changing AI_BASE_URL and AI_MODEL.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
# Set to mock to try the AI panel without a key (demo answers only).
AI_PROVIDER=
