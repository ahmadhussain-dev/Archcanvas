# Copy to api/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string, or a local server
MONGODB_URI=mongodb://127.0.0.1:27017/archcanvas

# The web app's address, allowed by CORS and used for cookies
CLIENT_ORIGIN=http://localhost:5173

# Auth. Use long random strings (32+ characters), e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production with the placeholders below.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# AI (used later). Gemini free tier through its OpenAI-compatible endpoint.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=
