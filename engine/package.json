{
  "name": "blueprint3d-babylon",
  "version": "0.1.0",
  "description": "Blueprint-style 2D/3D architectural editor library for Babylon.js, supporting pink castle and home sandbox test maps.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./src/core/babylon.production.js"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./presets/pink-castle": "./src/presets/pinkCastle.js",
    "./presets/blueprint-test-map": "./src/presets/blueprintTestMap.js",
    "./furniture": "./src/furniture/index.js",
    "./rooms": "./src/rooms/index.js",
    "./openings": "./src/openings/index.js",
    "./materials": "./src/core/materialCatalog.js",
    "./babylon-runtime": "./src/core/babylon.production.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.js --outDir ../dist --emptyOutDir",
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.js\"",
    "update-catalogs": "node skills/create-buildings/scripts/update-catalogs.mjs",
    "dev:editor": "vite --config vite.embed.config.js",
    "build:editor": "vite build --config vite.embed.config.js --outDir ../../web/dist/editor --emptyOutDir"
  },
  "peerDependencies": {
    "@babylonjs/core": "^7.11.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^7.11.0",
    "jszip": "^3.10.1",
    "playwright": "^1.61.1",
    "vite": "^5.0.0"
  },
  "keywords": [
    "babylonjs",
    "blueprint3d",
    "3d",
    "castle",
    "floorplan"
  ],
  "private": true
}
